{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AkibMahdi/Checking_Account_Bonus_Automation/schema/offer.schema.json",
  "title": "Bank account signup bonus offer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "bank",
    "account",
    "bonus",
    "requirements",
    "clawback",
    "eligibility",
    "dates",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable slug: <bank>-<account>-<amount>-<year>"
    },
    "no_offer": {
      "type": "boolean",
      "description": "Set by extract.py when a previously-live page no longer shows an offer."
    },
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "type": {
          "type": "string",
          "enum": [
            "national_bank",
            "regional_bank",
            "credit_union",
            "online_bank",
            "neobank"
          ]
        },
        "chexsystems": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Does this bank pull ChexSystems on new applications? null = unknown."
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "personal_or_business"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "category": {
          "type": "string",
          "enum": [
            "checking",
            "savings",
            "business_checking",
            "business_savings",
            "money_market",
            "cd"
          ]
        },
        "monthly_fee": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 200
        },
        "fee_waiver": {
          "type": [
            "string",
            "null"
          ]
        },
        "personal_or_business": {
          "type": "string",
          "enum": [
            "personal",
            "business"
          ]
        },
        "min_opening_deposit": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "bonus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "description": "Headline (max achievable) bonus. Tier detail lives in `tiers`."
        },
        "currency": {
          "type": "string",
          "enum": [
            "USD"
          ]
        },
        "tiers": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "amount",
              "condition"
            ],
            "properties": {
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000
              },
              "condition": {
                "type": "string",
                "minLength": 3
              },
              "dd_cumulative": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "dd_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "min_balance": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "window_days": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 730
              },
              "repeatable_cycles": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 24
              }
            }
          }
        },
        "payout_days_after_completion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 400
        },
        "taxable_1099int": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tier_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "alternative",
            "additive",
            "repeating",
            null
          ],
          "description": "How to read `tiers`. alternative (default): mutually exclusive paths, bonus.amount == the largest tier. additive: tiers stack over time (e.g. an anniversary bonus), bonus.amount == their sum. repeating: one tier earned up to repeatable_cycles times, bonus.amount == amount x cycles."
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_deposit"
      ],
      "properties": {
        "direct_deposit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 60,
              "description": "Number of separate qualifying deposits required. null = unstated."
            },
            "min_amount_each": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "min_amount_cumulative": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "Total $ of DDs required across the window. Very different from min_amount_each."
            },
            "window_days": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 730
            },
            "window_starts": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "account_open",
                "first_deposit",
                "offer_enrollment",
                "coupon_enrollment",
                null
              ],
              "description": "Changes the whole plan timeline. Do not guess this."
            },
            "qualifying_notes": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "min_balance": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount"
              ],
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 0
                },
                "new_money": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "fund_within_days": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 730
                },
                "hold_days": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 730
                }
              }
            }
          ]
        },
        "debit_transactions": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "count"
              ],
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 200
                },
                "min_amount_each": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "window_days": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 730
                }
              }
            }
          ]
        },
        "bill_pay": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "count"
              ],
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                },
                "min_amount_each": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "window_days": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 730
                }
              }
            }
          ]
        },
        "enrollment_required": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Must the user register/enroll in the offer separately from opening the account?"
        },
        "credit_card_funding_allowed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "clawback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_hold_days_after_bonus": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1095
        },
        "early_close_fee": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 500
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cooldown_months": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 120
        },
        "cooldown_basis": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "per_person",
            "per_household",
            "per_ssn",
            "per_account",
            null
          ]
        },
        "cooldown_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "states_included": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "description": "null means nationwide. A list means ONLY these states."
        },
        "states_excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "existing_customer_allowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "pull_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "soft",
            "hard",
            "unknown",
            null
          ]
        },
        "in_branch_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "promo_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_seen"
      ],
      "properties": {
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Last day to open/enroll. null = no published end date."
        },
        "enroll_by": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "first_seen": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "last_verified",
        "verification_method",
        "confidence",
        "verified_by"
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "aggregator_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://"
          }
        },
        "last_verified": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "verification_method": {
          "type": "string",
          "enum": [
            "llm_extracted",
            "hand_entered",
            "user_reported",
            "issue_form"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "high = bank's own domain confirmed; medium = aggregator only; low = user-reported."
        },
        "verified_by": {
          "type": "string",
          "minLength": 2
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "archived_on": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Set by expire_sweep.py when the offer is moved to offers/archive/."
        }
      }
    },
    "data_points": {
      "type": "array",
      "description": "Crowdsourced field reports: what actually counted as a DD at this bank.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "counted",
          "method"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "counted": {
            "type": "boolean"
          },
          "method": {
            "type": "string",
            "minLength": 2
          },
          "amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
